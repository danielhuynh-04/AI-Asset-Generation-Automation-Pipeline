# ============================================================
# AI Asset Generation Automation Pipeline — .env.example
# COPY THIS FILE to .env and fill in your real values
# DO NOT commit .env to Git
# ============================================================

# ===== GEMINI API =====
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== GOOGLE SHEETS =====
# Path to your service account JSON file (downloaded from Google Cloud)
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
# Get Sheet ID from URL: docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# ===== GOOGLE DRIVE =====
# ID of the Drive folder to upload assets to
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ===== SLACK NOTIFICATION =====
# Get from: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===== EMAIL NOTIFICATION (SMTP) =====
# Gmail: enable "App Password" in Google Account → Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_ADMIN=admin_recipient@gmail.com

# ===== PIPELINE SETTINGS =====
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
IMAGE_SIZE=1024
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# ===== DAILY REPORT =====
REPORT_SCHEDULE_HOUR=23
REPORT_SCHEDULE_MINUTE=0
